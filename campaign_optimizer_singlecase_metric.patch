+def _score_specs_from_config(objective_config: dict[str, Any]) -> dict[str, list[str]]:
+    specs = {score: list(cols) for score, cols in DEFAULT_SCORE_SPECS.items()}
+    configured = objective_config.get("score_specs")
+
+    if configured is None:
+        return specs
+
+    if not isinstance(configured, dict):
+        raise ValueError("objective.score_specs must be an object")
+
+    for score, cols in configured.items():
+        if not isinstance(score, str) or not score:
+            raise ValueError("objective.score_specs keys must be non-empty strings")
+        if not isinstance(cols, list) or not cols:
+            raise ValueError(
+                f"objective.score_specs[{score!r}] must be a non-empty list"
+            )
+        if not all(isinstance(col, str) and col for col in cols):
+            raise ValueError(
+                f"objective.score_specs[{score!r}] must contain non-empty strings"
+            )
+        specs[score] = list(cols)
+
+    return specs
+
